            [
              144.77,
              -37.94
            ]
          ]
        ]
      }
    },
    "clipExtent": [
      [
        0,
        0
      ],
      [
        620,
        720
      ]
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australian-states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e3e6dd",
        "stroke": "#8b998e",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/lga.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Count": "number",
            "Employed": "number",
            "Share": "number",
            "Longitude": "number",
            "Latitude": "number"
          }
        }
      },
      "transform": [
        {
          "window": [
            {
              "op": "rank",
              "as": "CountRank"
            }
          ],
          "sort": [
            {
              "field": "Count",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.CountRank<=10"
        },
        {
          "filter": "datum.State==='Victoria'"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.85,
        "stroke": "#825911",
        "strokeWidth": 1.3
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "Count",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              8000
            ],
            "range": [
              0,
              1600
            ]
          },
          "legend": null
        },
        "color": {
          "field": "Share",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              0.04
            ],
            "range": [
              "#fff3c4",
              "#9b6405"
            ]
          },
          "legend": null
        },
        "order": {
          "field": "Count",
          "type": "quantitative",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "LGA",
            "title": "Local government area"
          },
          {
            "field": "Count",
            "format": ",.0f",
            "title": "Bicycle commuters"
          },
          {
            "field": "Employed",
            "format": ",.0f",
            "title": "Employed residents"
          },
          {
            "field": "Share",
            "format": ".2%",
            "title": "Bicycle / employed residents"
          }
        ]
      }
    },
