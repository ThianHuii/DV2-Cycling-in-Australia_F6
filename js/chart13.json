{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 480,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 15,
    "right": 30,
    "top": 20,
    "bottom": 15
  },
  "background": "white",
  "data": {
    "url": "data/monthly-counts.csv",
    "format": {
      "type": "csv",
      "parse": {
        "count": "number",
        "month_order": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.station==='Sydney Harbour Bridge' || datum.station==='Anzac Bridge'"
    },
    {
      "pivot": "station",
      "value": "count",
      "groupby": [
        "month",
        "month_date",
        "month_order"
      ]
    }
  ],
  "encoding": {
    "x": {
      "field": "Sydney Harbour Bridge",
      "type": "quantitative",
      "scale": {
        "zero": false,
        "nice": false,
        "domain": [1250, 2200]
      },
      "axis": {
        "title": "Sydney Harbour Bridge · Recorded bicycle count",
        "format": ".0f",
        "values": [1300, 1500, 1700, 1900, 2100],
        "labelAngle": 0,
        "labelPadding": 10,
        "labelOverlap": true,
        "titlePadding": 22
      }
    },
    "y": {
      "field": "Anzac Bridge",
      "type": "quantitative",
      "scale": {
        "zero": false,
        "nice": false,
        "domain": [1000, 1650]
      },
      "axis": {
        "title": "Anzac Bridge · Recorded bicycle count",
        "format": ".0f",
        "values": [1000, 1100, 1200, 1300, 1400, 1500, 1600],
        "labelPadding": 12,
        "titlePadding": 30
      }
    },
    "tooltip": [
      {
        "field": "month",
        "title": "Month"
      },
      {
        "field": "month_date",
        "title": "Period"
      },
      {
        "field": "Sydney Harbour Bridge",
        "type": "quantitative",
        "title": "Sydney Harbour Bridge",
        "format": ".0f"
      },
      {
        "field": "Anzac Bridge",
        "type": "quantitative",
        "title": "Anzac Bridge",
        "format": ".0f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#526b78",
        "strokeWidth": 2,
        "opacity": 0.65
      },
      "encoding": {
        "order": {
          "field": "month_order",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 130,
        "opacity": 1,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.month==='Jun'",
            "value": "#b84b26"
          },
          "value": "#526b78"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.month_order!==2 && datum.month_order!==11 && datum.month_order!==12"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -17,
        "fontSize": 18,
        "color": "#203d32"
      },
      "encoding": {
        "text": {
          "field": "month_order",
          "format": ".0f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.month_order===2"
        }
      ],
      "mark": {
        "type": "text",
        "dx": 14,
        "dy": 16,
        "fontSize": 18,
        "color": "#203d32"
      },
      "encoding": {
        "text": {
          "field": "month_order"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.month_order===11"
        }
      ],
      "mark": {
        "type": "text",
        "dx": -15,
        "dy": -18,
        "fontSize": 18,
        "color": "#203d32"
      },
      "encoding": {
        "text": {
          "field": "month_order"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.month_order===12"
        }
      ],
      "mark": {
        "type": "text",
        "dx": 16,
        "dy": 18,
        "fontSize": 18,
        "color": "#203d32"
      },
      "encoding": {
        "text": {
          "field": "month_order"
        }
      }
    }
  ],
  "title": {
    "text": "Both bridges reach their lowest count in June.",
    "subtitle": [
      "Numbers follow October (1) through September (12).",
      "Follow the connecting line in numerical order."
    ],
    "anchor": "start",
    "fontSize": 22,
    "subtitleFontSize": 18,
    "subtitlePadding": 10,
    "offset": 20
  },
  "config": {
    "font": "Source Sans 3",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 18,
      "titleFontSize": 18,
      "labelColor": "#33463e",
      "titleColor": "#33463e",
      "gridColor": "#e2e8e3"
    },
    "title": {
      "font": "Bree Serif",
      "subtitleFont": "Source Sans 3"
    }
  }
}
